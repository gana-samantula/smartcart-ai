# Copy to .env for local development. Never commit .env.
# Values below are placeholders. Generate real secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# docker compose (Postgres container)
POSTGRES_PASSWORD=change-me-local-only
# Host port for the Postgres container. Defaults to 5434 when unset.
POSTGRES_HOST_PORT=5434

# Backend API
SMARTCART_ENVIRONMENT=development
SMARTCART_LOG_LEVEL=INFO
SMARTCART_DATABASE_URL=postgresql+psycopg://smartcart:change-me-local-only@127.0.0.1:5432/smartcart
SMARTCART_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters
# JSON list, e.g. ["http://localhost:3000"]. Leave empty to disable CORS.
SMARTCART_CORS_ALLOWED_ORIGINS=[]
